    "lucide-react": "^0.577.0",
    "next": "16.4.4",
    "next-intl": "4.14.9",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
